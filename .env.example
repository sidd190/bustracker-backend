DATABASE_URL="postgresql://user:password@localhost:5432/bustracker"
JWT_SECRET="your-super-secret-jwt-key-change-this"
PORT=3001

# ── Fleettrack GPS integration ───────────────────────────────────────────────
# Leave TOKEN/EMAIL blank to keep the GPS poller dormant.
# Token is constant per user; email is the account holder's email.
FLEETTRACK_TOKEN=""
FLEETTRACK_EMAIL=""
FLEETTRACK_BASE_URL="https://app.gpstrack.in"
FLEETTRACK_POLL_MS=15000      # how often to pull current state (ms)
FLEETTRACK_STALE_MS=90000     # hide a GPS bus if it hasn't reported in-service within this window (ms)
FLEETTRACK_SHOW_PARKED=""     # set "true" during a pilot to show parked/ignition-off buses too
